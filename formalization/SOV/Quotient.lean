import Mathlib.Logic.Relation
import Mathlib.Data.List.Dedup
import SOV.Monad
import SOV.Confluence

/-!
# The ledger quotient

The user's specification (2026-10-29): two event logs are the same ledger when they differ only
by repeated firings of the same operator on the same slot in the same episode. All distinct
(operator, slot, episode) triples are kept, in order.

Formalized: each entry is stamped with its episode, and its key is (event tag, target slot,
episode). `SameLedger` is the equivalence generated by deleting an entry whose key already
occurred earlier (`DropRepeat`).

## What it does

* It is a congruence (`SameLedger.append_right`, `SameLedger.append_left`).
* It collapses repeats (`collapse`): Phase 4's `constrain_twice` schedules become one ledger.
* It keeps the order of first occurrences (`firstKeys_eq`): entries with distinct keys can't be
  swapped (`order_preserved`), so a Fit and an eviction in either order stay distinct ledgers,
  as Phase 5 needs.

## Where it falls short

* **It doesn't respect ledger state when repeats aren't adjacent** (`not_respects_state`).
  Evict, Fit, evict on one slot in one episode collapses to evict, Fit, but the first leaves
  the slot's lived mass at 0 and the second at 1. Anneal has the same shape: two anneals of
  one slot in one episode collapse to the first, while the state goes to the later time.
* **It keeps Phase 4's confluent core apart** (`p66_schedules_distinguished`). Two fair
  Constrain/Exclude schedules firing the same operators in different orders write their
  receipts in different orders, so they are different ledgers here, though Phase 4 proved
  them equal as event sets.

## The trace quotient

Both failures are fixed by a trace quotient. Call an event *inert* when replaying it changes no
ledger state: earned accruals, liens, retraction notices, attestations, coordination
(`step_of_inert`). `SameTrace` is generated by swapping two adjacent inert events and
collapsing an adjacent duplicate inert event. Then:

* **R1, it respects ledger state** (`SameTrace.replay_eq`): equivalent logs replay identically
  from every state.
* **R2, it identifies the confluent core** (`sameTrace_of_mem_iff`, `p66_ledger`): inert logs
  with the same events are equivalent, so Phase 4's Constrain/Exclude schedules that fire the
  same operators write the same ledger.
* **R3, it keeps state-changing order** (`fit_evict_distinct`, `fit_repeat_distinct`): Fit and
  evict in either order stay distinct, and so does a repeated lived accrual.
* **It is the least such congruence** (`SameTrace.minimal`): any congruence satisfying R2
  contains it.

Two choices it makes:

* A repeated *lived* accrual is not collapsed, since replay counts each one. If Fit earns at
  most one receipt per episode (sov_formal_spec §3.2), that is a well-formedness condition on
  logs, not a quotient.
* Inert events don't commute past state-changing ones. Allowing that would still respect
  state but identify more than R2 requires.
-/

namespace SOV

/-- The slot an event acts on (`none` is the unassigned pool). -/
def FiberEvent.target {S A C E : Type*} : FiberEvent S A C E → Option S
  | .accrue t _ => t
  | .pool _ d _ => some d
  | .partition s _ _ _ => some s
  | .lien sup _ => some sup
  | .discountTransfer d _ _ => some d
  | .retract s => some s
  | .evict s => some s
  | .anneal s _ => some s
  | .coordinationAccrue i _ _ => some i

namespace Quotient

variable {S A C E : Type*}

/-- A ledger entry, stamped with the episode it was written in. -/
abbrev Entry (S A C E : Type*) :=
  FiberEvent S A C E × E

/-- The firing key: operator (event tag), slot, episode. -/
def key (x : Entry S A C E) : EventTag × Option S × E :=
  (x.1.tag, x.1.target, x.2)

/-- Delete an entry whose key already occurred earlier. -/
inductive DropRepeat : List (Entry S A C E) → List (Entry S A C E) → Prop
  | mk (a b : List (Entry S A C E)) (x y : Entry S A C E) (hy : y ∈ a) (hk : key y = key x) :
    DropRepeat (a ++ x :: b) (a ++ b)

/-- Two logs are the same ledger: related by dropping and restoring repeats. -/
def SameLedger : List (Entry S A C E) → List (Entry S A C E) → Prop :=
  Relation.EqvGen DropRepeat

theorem eqvGen_map {α β : Type*} {r : α → α → Prop} {r' : β → β → Prop} (f : α → β)
    (hf : ∀ a b, r a b → r' (f a) (f b)) {a b : α} (h : Relation.EqvGen r a b) :
    Relation.EqvGen r' (f a) (f b) := by
  induction h with
  | rel _ _ h => exact .rel _ _ (hf _ _ h)
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ ih₁ ih₂ => exact .trans _ _ _ ih₁ ih₂

/-- A congruence on the right. -/
theorem SameLedger.append_right {l l' : List (Entry S A C E)} (h : SameLedger l l')
    (m : List (Entry S A C E)) : SameLedger (l ++ m) (l' ++ m) :=
  eqvGen_map (· ++ m) (fun _ _ h ↦ by
    obtain ⟨a, b, x, y, hy, hk⟩ := h
    simpa using DropRepeat.mk a (b ++ m) x y hy hk) h

/-- A congruence on the left. -/
theorem SameLedger.append_left {l l' : List (Entry S A C E)} (h : SameLedger l l')
    (m : List (Entry S A C E)) : SameLedger (m ++ l) (m ++ l') :=
  eqvGen_map (m ++ ·) (fun _ _ h ↦ by
    obtain ⟨a, b, x, y, hy, hk⟩ := h
    simpa using DropRepeat.mk (m ++ a) b x y (List.mem_append_right _ hy) hk) h

/-- Repeats collapse. -/
theorem collapse (x : Entry S A C E) : SameLedger [x, x] [x] :=
  .rel _ _ (DropRepeat.mk [x] [] x x (List.mem_singleton_self x) rfl)

variable [DecidableEq S] [DecidableEq E]

/-- Keys in order of first occurrence (as `dedup` of the reversed key list). -/
def firstKeys (l : List (Entry S A C E)) : List (EventTag × Option S × E) :=
  ((l.map key).reverse).dedup

theorem firstKeys_dropRepeat {l l' : List (Entry S A C E)} (h : DropRepeat l l') :
    firstKeys l = firstKeys l' := by
  obtain ⟨a, b, x, y, hy, hk⟩ := h
  have hx : key x ∈ (a.map key).reverse := by
    rw [List.mem_reverse, ← hk]
    exact List.mem_map_of_mem hy
  simp only [firstKeys, List.map_append, List.map_cons, List.reverse_append, List.reverse_cons,
    List.append_assoc, List.dedup_append, List.singleton_append, List.dedup_cons_of_mem hx]

/-- The order of first occurrences is an invariant of the quotient. -/
theorem firstKeys_eq {l l' : List (Entry S A C E)} (h : SameLedger l l') :
    firstKeys l = firstKeys l' := by
  induction h with
  | rel _ _ h => exact firstKeys_dropRepeat h
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

omit [DecidableEq S] [DecidableEq E] in
/-- Entries with distinct keys can't be swapped. -/
theorem order_preserved {x y : Entry S A C E} (hxy : key x ≠ key y) :
    ¬ SameLedger [x, y] [y, x] := by
  classical
  intro h
  have := firstKeys_eq h
  simp [firstKeys, List.dedup_cons_of_notMem, hxy, Ne.symm hxy] at this

omit [DecidableEq E] in
/-- **The quotient doesn't respect ledger state when repeats aren't adjacent.** Evict, Fit,
evict on one slot in one episode is the same ledger as evict, Fit, but leaves the slot's lived
mass at 0 rather than 1. -/
theorem not_respects_state (i : S) (c : C) (ep : E) :
    SameLedger
        [((.evict i : FiberEvent S A C E), ep), (.accrue (some i) (.lived c ep), ep),
          (.evict i, ep)]
        [((.evict i : FiberEvent S A C E), ep), (.accrue (some i) (.lived c ep), ep)] ∧
      ((⟨0, 0, fun _ ↦ 0, fun _ ↦ 0⟩ : LedgerState S).replay
          [(.evict i : FiberEvent S A C E), .accrue (some i) (.lived c ep), .evict i]).mass
          (some i) = 0 ∧
      ((⟨0, 0, fun _ ↦ 0, fun _ ↦ 0⟩ : LedgerState S).replay
          [(.evict i : FiberEvent S A C E), .accrue (some i) (.lived c ep)]).mass (some i) = 1 := by
  refine ⟨.rel _ _ (DropRepeat.mk [((.evict i : FiberEvent S A C E), ep),
    (.accrue (some i) (.lived c ep), ep)] [] (.evict i, ep) (.evict i, ep)
    (List.mem_cons_self) rfl), ?_, ?_⟩ <;>
    simp [LedgerState.replay, LedgerState.step, Accrual.livedMass]

omit [DecidableEq S] [DecidableEq E] in
/-- **The quotient keeps Phase 4's confluent core apart.** A Constrain receipt and an Exclude
receipt, written in either order in one episode, are different ledgers. -/
theorem p66_schedules_distinguished (i k : S) (ep : E) :
    ¬ SameLedger
      [((.accrue (some i) (.earned .transitive) : FiberEvent S A C E), ep),
        (.accrue (some k) (.earned .negative), ep)]
      [((.accrue (some k) (.earned .negative) : FiberEvent S A C E), ep),
        (.accrue (some i) (.earned .transitive), ep)] :=
  order_preserved (by simp [key, FiberEvent.tag])

/-! ### The trace quotient -/

/-- An event whose replay changes no ledger state. -/
def Inert : FiberEvent S A C E → Prop
  | .accrue _ (.earned _) | .lien .. | .discountTransfer .. | .retract _ | .coordinationAccrue .. =>
    True
  | _ => False

omit [DecidableEq E] in
theorem step_of_inert (st : LedgerState S) {e : FiberEvent S A C E} (h : Inert e) :
    st.step e = st := by
  cases e
  case accrue t a =>
    cases a
    · exact (h : False).elim
    · cases st
      simp [LedgerState.step, Accrual.livedMass]
  all_goals first | rfl | exact (h : False).elim

/-- The generating moves: swap two adjacent inert events, or collapse an adjacent duplicate
inert event. -/
inductive TraceStep : List (FiberEvent S A C E) → List (FiberEvent S A C E) → Prop
  | swap (a b : List (FiberEvent S A C E)) (x y : FiberEvent S A C E) (hx : Inert x)
    (hy : Inert y) : TraceStep (a ++ x :: y :: b) (a ++ y :: x :: b)
  | dup (a b : List (FiberEvent S A C E)) (x : FiberEvent S A C E) (hx : Inert x) :
    TraceStep (a ++ x :: x :: b) (a ++ x :: b)

/-- Two logs are the same trace. -/
def SameTrace : List (FiberEvent S A C E) → List (FiberEvent S A C E) → Prop :=
  Relation.EqvGen TraceStep

omit [DecidableEq S] [DecidableEq E] in
theorem SameTrace.append_right {l l' : List (FiberEvent S A C E)} (h : SameTrace l l')
    (m : List (FiberEvent S A C E)) : SameTrace (l ++ m) (l' ++ m) :=
  eqvGen_map (· ++ m) (fun _ _ h ↦ by
    cases h with
    | swap a b x y hx hy => simpa using TraceStep.swap a (b ++ m) x y hx hy
    | dup a b x hx => simpa using TraceStep.dup a (b ++ m) x hx) h

omit [DecidableEq S] [DecidableEq E] in
theorem SameTrace.append_left {l l' : List (FiberEvent S A C E)} (h : SameTrace l l')
    (m : List (FiberEvent S A C E)) : SameTrace (m ++ l) (m ++ l') :=
  eqvGen_map (m ++ ·) (fun _ _ h ↦ by
    cases h with
    | swap a b x y hx hy => simpa using TraceStep.swap (m ++ a) b x y hx hy
    | dup a b x hx => simpa using TraceStep.dup (m ++ a) b x hx) h

omit [DecidableEq E] in
theorem TraceStep.replay_eq {l l' : List (FiberEvent S A C E)} (h : TraceStep l l')
    (st : LedgerState S) : st.replay l = st.replay l' := by
  cases h with
  | swap a b x y hx hy =>
    have hx' : ∀ s : LedgerState S, s.step x = s := fun s ↦ step_of_inert s hx
    have hy' : ∀ s : LedgerState S, s.step y = s := fun s ↦ step_of_inert s hy
    simp [LedgerState.replay, hx', hy']
  | dup a b x hx =>
    have hx' : ∀ s : LedgerState S, s.step x = s := fun s ↦ step_of_inert s hx
    simp [LedgerState.replay, hx']

omit [DecidableEq E] in
/-- **R1: the trace quotient respects ledger state.** -/
theorem SameTrace.replay_eq {l l' : List (FiberEvent S A C E)} (h : SameTrace l l') :
    LedgerState.LedgerEquiv l l' := by
  induction h with
  | rel _ _ h => exact h.replay_eq
  | refl => exact fun _ ↦ rfl
  | symm _ _ _ ih => exact fun st ↦ (ih st).symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact fun st ↦ (ih₁ st).trans (ih₂ st)

omit [DecidableEq S] [DecidableEq E] in
theorem sameTrace_of_perm {l l' : List (FiberEvent S A C E)} (h : l.Perm l')
    (hl : ∀ e ∈ l, Inert e) : SameTrace l l' := by
  induction h with
  | nil => exact .refl _
  | cons x _ ih =>
    exact SameTrace.append_left (ih fun e he ↦ hl e (List.mem_cons_of_mem _ he)) [x]
  | swap x y l =>
    exact .rel _ _ (TraceStep.swap [] l y x (hl y List.mem_cons_self)
      (hl x (List.mem_cons_of_mem _ List.mem_cons_self)))
  | trans h₁ _ ih₁ ih₂ =>
    exact .trans _ _ _ (ih₁ hl) (ih₂ fun e he ↦ hl e (h₁.mem_iff.2 he))

omit [DecidableEq S] [DecidableEq E] in
theorem sameTrace_cons_of_mem {x : FiberEvent S A C E} {l : List (FiberEvent S A C E)}
    (hx : x ∈ l) (hl : ∀ e ∈ x :: l, Inert e) : SameTrace (x :: l) l := by
  classical
  have p : l.Perm (x :: l.erase x) := List.perm_cons_erase hx
  have hl' : ∀ e ∈ l, Inert e := fun e he ↦ hl e (List.mem_cons_of_mem _ he)
  refine .trans _ (x :: x :: l.erase x) _ (sameTrace_of_perm (p.cons x) hl) ?_
  refine .trans _ (x :: l.erase x) _
    (.rel _ _ (TraceStep.dup [] (l.erase x) x (hl x List.mem_cons_self))) ?_
  exact sameTrace_of_perm p.symm fun e he ↦ hl' e (p.symm.mem_iff.1 he)

omit [DecidableEq S] [DecidableEq E] in
theorem sameTrace_dedup [DecidableEq (FiberEvent S A C E)] {l : List (FiberEvent S A C E)}
    (hl : ∀ e ∈ l, Inert e) : SameTrace l l.dedup := by
  induction l with
  | nil => exact .refl _
  | cons x l ih =>
    have hl' : ∀ e ∈ l, Inert e := fun e he ↦ hl e (List.mem_cons_of_mem _ he)
    by_cases hx : x ∈ l
    · rw [List.dedup_cons_of_mem hx]
      exact .trans _ _ _ (sameTrace_cons_of_mem hx hl) (ih hl')
    · rw [List.dedup_cons_of_notMem hx]
      exact SameTrace.append_left (ih hl') [x]

omit [DecidableEq S] [DecidableEq E] in
/-- **R2: inert logs with the same events are the same trace.** -/
theorem sameTrace_of_mem_iff {l l' : List (FiberEvent S A C E)} (hl : ∀ e ∈ l, Inert e)
    (h : ∀ e, e ∈ l ↔ e ∈ l') : SameTrace l l' := by
  classical
  have hl' : ∀ e ∈ l', Inert e := fun e he ↦ hl e ((h e).2 he)
  have p : l.dedup.Perm l'.dedup :=
    (List.perm_ext_iff_of_nodup (List.nodup_dedup l) (List.nodup_dedup l')).2
      (by simp [List.mem_dedup, h])
  exact .trans _ _ _ (sameTrace_dedup hl)
    (.trans _ _ _ (sameTrace_of_perm p fun e he ↦ hl e (List.mem_dedup.1 he))
      (.symm _ _ (sameTrace_dedup hl')))

omit [DecidableEq S] [DecidableEq E] in
/-- **The trace quotient is the least congruence satisfying R2.** -/
theorem SameTrace.minimal (r : List (FiberEvent S A C E) → List (FiberEvent S A C E) → Prop)
    (hr : Equivalence r)
    (hcong : ∀ l l' m₁ m₂, r l l' → r (m₁ ++ l ++ m₂) (m₁ ++ l' ++ m₂))
    (hR2 : ∀ l l', (∀ e ∈ l, Inert e) → (∀ e, e ∈ l ↔ e ∈ l') → r l l')
    {l l' : List (FiberEvent S A C E)} (h : SameTrace l l') : r l l' := by
  induction h with
  | rel _ _ h =>
    cases h with
    | swap a b x y hx hy =>
      simpa using hcong [x, y] [y, x] a b
        (hR2 _ _ (by simp [hx, hy]) (fun e ↦ by simp [or_comm]))
    | dup a b x hx =>
      simpa using hcong [x, x] [x] a b (hR2 _ _ (by simp [hx]) (fun e ↦ by simp))
  | refl => exact hr.refl _
  | symm _ _ _ ih => exact hr.symm ih
  | trans _ _ _ _ _ ih₁ ih₂ => exact hr.trans ih₁ ih₂

omit [DecidableEq S] [DecidableEq E] in
/-- **R3: Fit and evict keep their order.** -/
theorem fit_evict_distinct (i : S) (c : C) (e : E) :
    ¬ SameTrace ([.accrue (some i) (.lived c e), .evict i] : List (FiberEvent S A C E))
      [.evict i, .accrue (some i) (.lived c e)] := by
  classical
  exact fun h ↦ (LedgerState.accrue_evict_not_comm i c e).2 h.replay_eq

omit [DecidableEq S] [DecidableEq E] in
/-- A repeated lived accrual is not collapsed: replay counts each one. -/
theorem fit_repeat_distinct (t : Option S) (c : C) (e : E) :
    ¬ SameTrace ([.accrue t (.lived c e), .accrue t (.lived c e)] : List (FiberEvent S A C E))
      [.accrue t (.lived c e)] := by
  classical
  intro h
  have := congrArg (fun st : LedgerState S ↦ st.mass t) (h.replay_eq ⟨0, 0, fun _ ↦ 0, fun _ ↦ 0⟩)
  simp [LedgerState.replay, LedgerState.step, Accrual.livedMass] at this

omit [DecidableEq E] in
/-- **Phase 4's confluent core, on the whole ledger.** Two Constrain/Exclude schedules that fire
the same operators write the same trace. -/
theorem p66_ledger {K B R : Type*} [SemilatticeInf B] [GeometryAlgebra B R]
    {σ τ : List (Operator S B R A C E)} (hσ : ∀ op ∈ σ, op.InFragment)
    (hτ : ∀ op ∈ τ, op.InFragment) (hst : ∀ op, op ∈ σ ↔ op ∈ τ) (w : Web S K B R A C E) :
    SameTrace (Operator.run σ w).ledger.log (Operator.run τ w).ledger.log := by
  rw [Operator.run_log_fragment hσ, Operator.run_log_fragment hτ]
  refine SameTrace.append_left (sameTrace_of_mem_iff (fun e he ↦ ?_) fun e ↦ ?_) _
  · obtain ⟨op, -, he⟩ := List.mem_flatMap.1 he
    cases op <;> simp only [Operator.fragFiber, List.mem_singleton, List.not_mem_nil] at he <;>
      (subst he; trivial)
  · simp [List.mem_flatMap, hst]

end Quotient

end SOV
